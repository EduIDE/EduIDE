# syntax=docker/dockerfile:1
# Load the base-ide image, only copy from here
ARG BASE_IDE_TAG=latest
ARG BASE_IMAGE=ghcr.io/eduide/eduide/base:${BASE_IDE_TAG}
FROM ${BASE_IMAGE} AS base-ide

# Parallel stage: Install system dependencies (runs concurrently with plugin-image)
FROM ubuntu:26.04 AS apt-deps

WORKDIR /home/theia

# Create the theia user and directories before apt installs anything: with
# the group at gid 101 first, openssh-client's _ssh group lands elsewhere
# instead of taking 101 (which made the session run as gid _ssh).
RUN groupadd --system --gid 101 theia && \
    useradd --system --create-home --gid 101 --uid 101 theia && \
    chmod g+rw /home && \
    mkdir -p /home/project && \
    chown -R theia:theia /home/theia && \
    chown -R theia:theia /home/project

# Install all system dependencies with BuildKit cache mounts (including adduser)
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get -o Acquire::Retries=5 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 update && \
    apt-get -o Acquire::Retries=5 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 install -y --no-install-recommends \
    adduser build-essential bash zsh git openssh-client curl less nano unzip ca-certificates

# Parallel stage: Plugin download (runs concurrently with apt-deps)
FROM node:22-trixie AS plugin-image

WORKDIR /home/theia

# Configure to skip download of puppeteer
ENV PUPPETEER_SKIP_DOWNLOAD=true

# Copy required configuration files
COPY --from=base-ide /home/theia/package.json ./package.json.base
COPY images/rust/package.json.patch ./package.json.patch
COPY scripts/merge-package-json.js /usr/local/bin/merge-package-json.js

# Merge the base package.json with the rust-specific patch without dropping base exclusions.
RUN node /usr/local/bin/merge-package-json.js package.json.base package.json.patch package.json && \
    rm package.json.base package.json.patch

# Fail early if the patch nulled or dropped an extension EduIDE itself needs
RUN --mount=type=bind,source=scripts/check-required-plugins.sh,target=/tmp/check-required-plugins.sh \
    sh /tmp/check-required-plugins.sh --package-json package.json

# Open VSX and GitHub ship rust-analyzer and CodeLLDB per platform; the patch pins
# linux-x64, swap in the build for the architecture this image is made for.
ARG TARGETARCH
RUN arch="linux-$( [ "${TARGETARCH}" = arm64 ] && echo arm64 || echo x64 )" && \
    sed -i "s#/linux-x64/#/${arch}/#g; s#@linux-x64\.vsix#@${arch}.vsix#g; s#codelldb-linux-x64\.vsix#codelldb-${arch}.vsix#g" package.json

# Copy from base-ide: scripts, configs, existing plugins, and production node_modules
COPY --from=base-ide /home/theia/scripts /home/theia/scripts
COPY --from=base-ide /home/theia/configs /home/theia/configs
COPY --from=base-ide /home/theia/tsconfig.json /home/theia/tsconfig.json
COPY --from=base-ide /home/theia/plugins /home/theia/plugins
COPY --from=base-ide /home/theia/node_modules /home/theia/node_modules

# Install ONLY @theia/cli (needed for download:plugins command)
RUN n=0; until yarn add -W @theia/cli@1.74.1 --network-timeout 1000000 --network-concurrency 3; do \
        n=$((n+1)); \
        if [ "$n" -ge 5 ]; then echo "yarn add @theia/cli failed after $n attempts" >&2; exit 1; fi; \
        echo "yarn add @theia/cli failed (attempt $n), retrying..."; \
        sleep $((n*3)); \
    done

# Download language-specific plugins
RUN --mount=type=cache,id=theia-plugin-cache-rust,target=/home/theia/.plugin-cache,sharing=locked \
    yarn download:plugins:smart

# Final stage: Assemble the application
FROM apt-deps AS final-ide

# Copy node binary from plugin-image (required for Theia runtime)
COPY --from=plugin-image /usr/local/bin/node /usr/local/bin/

ENV HOME=/home/theia
WORKDIR /home/theia

# Copy application from base-ide (includes prod node_modules)
COPY --from=base-ide --chown=theia:theia /home/theia /home/theia

# Copy additional plugins (language-specific extensions)
COPY --from=plugin-image --chown=theia:theia /home/theia/plugins /home/theia/plugins

# Copy project settings (includes .vscode/settings.json with file exclusions)
COPY --chown=theia:theia images/rust/project /home/project

# Project templates, picked by Scorpio via TEMPLATE and copied into an empty workspace
COPY --chown=theia:theia images/rust/templates /home/theia/templates

EXPOSE 3000

# Specify default shell for Theia and the Built-In plugins directory
# The HTML preview (mini-browser) needs its own origin per preview. Reuse the webview
# host family, which the gateway already routes and certifies; the default
# {{uuid}}.mini-browser.{{hostname}} has no route. ENV is not inherited from the base image.
ENV SHELL=/bin/zsh \
    THEIA_DEFAULT_PLUGINS=local-dir:/home/theia/plugins \
    THEIA_MINI_BROWSER_HOST_PATTERN="{{uuid}}.webview.{{hostname}}"

# Use installed git instead of dugite
ENV USE_LOCAL_GIT=true

# Switch to Theia user
USER theia

# Install the pinned Rust toolchain with the minimal profile plus the components
# a course needs offline (rustfmt, clippy, rust-analyzer, rust-src for go-to-definition into std), then clean up.
# Replace bundled rust-analyzer server with rustup version to ensure
# proc-macro API version compatibility with the Rust toolchain
# renovate: datasource=github-tags depName=rust-lang/rust versioning=semver
ARG RUST_VERSION=1.100.0
RUN curl --retry 5 --retry-all-errors --retry-delay 2 --connect-timeout 30 --max-time 300 --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs --output rust.sh \
    && chmod +x rust.sh \
    && ./rust.sh -y --profile minimal --default-toolchain "${RUST_VERSION}" \
    && rm rust.sh \
    && . "$HOME/.cargo/env" \
    && rustup component add rustfmt clippy rust-analyzer rust-src \
    && cp /home/theia/.cargo/bin/rust-analyzer /home/theia/plugins/rust-analyzer/extension/server/rust-analyzer \
    && rm -rf $HOME/.cargo/registry \
    && rm -rf $HOME/.cargo/git \
    && rm -rf $HOME/.rustup/downloads \
    && rm -rf $HOME/.rustup/toolchains/*/share/doc

# Add Rust to the global PATH for all users
ENV PATH=/home/theia/.cargo/bin:$PATH

# Ensure the environment is set correctly when switching to the user "theia"
RUN echo 'source $HOME/.cargo/env' >> /home/theia/.zshrc

WORKDIR /home/theia/applications/browser

# Stamp the published image coordinates into the environment so the About
# dialog can name the image this session is running. The revision is what
# separates two builds that share a tag, such as successive `latest` ones.
# CI supplies all three; a hand-built image leaves them empty and the dialog
# then says "unknown".
ARG APP_VERSION=""
ARG IMAGE_NAME=""
ARG IMAGE_REVISION=""
ENV EDUIDE_IMAGE_NAME=${IMAGE_NAME} \
    EDUIDE_IMAGE_TAG=${APP_VERSION} \
    EDUIDE_IMAGE_REVISION=${IMAGE_REVISION}

# Fail the build if a language patch dropped an extension EduIDE itself needs
RUN --mount=type=bind,source=scripts/check-required-plugins.sh,target=/tmp/check-required-plugins.sh \
    sh /tmp/check-required-plugins.sh /home/theia/plugins

# Launch the backend application via node
ENTRYPOINT [ "node", "/home/theia/applications/browser/lib/backend/main.js" ]

# Arguments passed to the application
CMD [ "/home/project", "--hostname=127.0.0.1" ]
