{
    "java.server.launchMode": "Standard",
    "java.jdt.ls.vmargs": "-XX:+UseG1GC -XX:+UseStringDeduplication -XX:G1PeriodicGCInterval=30000 -Xmx768m -Xms64m -Xss512k -XX:MaxMetaspaceSize=256m -XX:MinHeapFreeRatio=10 -XX:MaxHeapFreeRatio=25",
    // Lombok ships inside redhat.java and is attached as a Java agent that
    // patches JDT's compiler AST classes. Its bundled build no longer matches
    // JDT, so every resolved-AST request dies with NoSuchFieldError on
    // ConstructorDeclaration.constructorCall — which silently kills rename,
    // Refactor..., Source Action... and resolution-based quick fixes while
    // leaving navigation and completion working. No EduIDE template uses
    // Lombok, so the agent is pure cost. Must be a user setting: the
    // extension reads it at activation and a workspace-level value is ignored.
    "java.jdt.ls.lombokSupport.enabled": false,
    "java.completion.maxResults": 30,
    "java.help.collectErrorLog": false,
    "java.help.firstView": "none",
    "java.help.showReleaseNotes": false,
    "java.silentNotification": true,
    "redhat.telemetry.enabled": false,
    "files.watcherExclude": {
        "**/.gradle/**": true,
        "**/build/**": true,
        "**/target/**": true,
        "**/.git/objects/**": true
    }
}
