{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "rootDir": ".",
        "outDir": "dist",
        // @types/node is installed globally in the image, so no npm install is needed.
        "typeRoots": ["/usr/local/lib/node_modules/@types"],
        "types": ["node"]
    },
    "include": ["src", "test"]
}
