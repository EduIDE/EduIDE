{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start",
            "type": "shell",
            "command": "tsc --watch",
            "isBackground": true,
            "group": { "kind": "build", "isDefault": true },
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": "$tsc-watch",
            "presentation": { "reveal": "always", "panel": "shared" }
        },
        {
            "label": "Build",
            "type": "shell",
            "command": "tsc",
            "group": "build",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": "$tsc",
            "presentation": { "reveal": "always", "panel": "shared" }
        }
    ]
}
