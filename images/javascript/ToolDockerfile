# syntax=docker/dockerfile:1
# Load the base-ide image, only copy from here
ARG BASE_IDE_TAG=latest
ARG BASE_IMAGE=ghcr.io/eduide/eduide/base:${BASE_IDE_TAG}
FROM ${BASE_IMAGE} AS base-ide

# Parallel stage: Install system dependencies (runs concurrently with plugin-image)
FROM ubuntu:26.04 AS apt-deps

WORKDIR /home/theia

# Create theia user and directories
RUN groupadd --system --gid 101 theia && \
    useradd --system --create-home --gid 101 --uid 101 theia && \
    chmod g+rw /home && \
    mkdir -p /home/project && \
    chown -R theia:theia /home/theia && \
    chown -R theia:theia /home/project

# Install all system dependencies with BuildKit cache mounts
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get -o Acquire::Retries=5 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 update && \
    apt-get -o Acquire::Retries=5 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 install -y --no-install-recommends bash zsh git openssh-client curl less nano unzip ca-certificates

# Parallel stage: Plugin download (runs concurrently with apt-deps)
FROM node:22-trixie AS plugin-image

WORKDIR /home/theia

# Configure to skip download of puppeteer
ENV PUPPETEER_SKIP_DOWNLOAD=true

# Copy required configuration files
COPY --from=base-ide /home/theia/package.json ./package.json.base
COPY images/javascript/package.json.patch ./package.json.patch
COPY scripts/merge-package-json.js /usr/local/bin/merge-package-json.js

# Merge the base package.json with the javascript-specific patch without dropping base exclusions.
RUN node /usr/local/bin/merge-package-json.js package.json.base package.json.patch package.json && \
    rm package.json.base package.json.patch

# Fail early if the patch nulled or dropped an extension EduIDE itself needs
RUN --mount=type=bind,source=scripts/check-required-plugins.sh,target=/tmp/check-required-plugins.sh \
    sh /tmp/check-required-plugins.sh --package-json package.json

# Copy from base-ide: scripts, configs, existing plugins, and production node_modules
COPY --from=base-ide /home/theia/scripts /home/theia/scripts
COPY --from=base-ide /home/theia/configs /home/theia/configs
COPY --from=base-ide /home/theia/tsconfig.json /home/theia/tsconfig.json
COPY --from=base-ide /home/theia/plugins /home/theia/plugins
COPY --from=base-ide /home/theia/node_modules /home/theia/node_modules

# Install ONLY @theia/cli (needed for download:plugins command)
RUN n=0; until yarn add -W @theia/cli@1.74.1 --network-timeout 1000000 --network-concurrency 3; do \
        n=$((n+1)); \
        if [ "$n" -ge 5 ]; then echo "yarn add @theia/cli failed after $n attempts" >&2; exit 1; fi; \
        echo "yarn add @theia/cli failed (attempt $n), retrying..."; \
        sleep $((n*3)); \
    done

# Global TypeScript CLI tooling for the terminal: tsc (compile/type-check) and tsx
# (run .ts files directly). tsx is self-contained and works with modern Node; ts-node
# 10.x silently no-ops on Node 22.
# @types/node is global too, so templates can point typeRoots at /usr/local/lib/node_modules/@types.
# renovate: datasource=npm depName=@types/node versioning=npm
ARG TYPES_NODE_VERSION=22.20.5
RUN npm install -g typescript@5.6.3 tsx@4.19.2 "@types/node@${TYPES_NODE_VERSION}"

# Download language-specific plugins
RUN --mount=type=cache,id=theia-plugin-cache-javascript,target=/home/theia/.plugin-cache,sharing=locked \
    yarn download:plugins:smart

# Final stage: Assemble the application
FROM apt-deps AS final-ide

# Copy Node.js from plugin-image (required for Theia runtime).
# Copy the whole bin dir (not just the `node` binary): it carries the npm/npx/corepack
# launcher symlinks plus the tsc/tsx launchers created by the global install above.
COPY --from=plugin-image /usr/local/bin/ /usr/local/bin/
COPY --from=plugin-image /usr/local/lib/node_modules/ /usr/local/lib/node_modules/

# Switch to Theia user
USER theia
ENV HOME=/home/theia
WORKDIR /home/theia

# Copy the application from the base without its node_modules: the backend is bundled into
# applications/browser/lib, so the runtime needs none of them (the plugin stage above still does).
COPY --from=base-ide --chown=theia:theia --exclude=node_modules /home/theia /home/theia

# Copy additional plugins (language-specific extensions)
COPY --from=plugin-image --chown=theia:theia /home/theia/plugins /home/theia/plugins

# Copy the project configuration files
COPY --from=base-ide --chown=theia:theia /home/theia/project /home/project
COPY --chown=theia:theia images/javascript/project /home/project

# Project templates, picked by Scorpio via TEMPLATE and copied into an empty workspace
COPY --chown=theia:theia images/javascript/templates /home/theia/templates

# Template metadata for the control plane (U12). The image workflow reads it into the OCI
# annotation io.eduide.template. Runs as root because /opt is not writable for theia.
ARG APP_VERSION=""
USER root
# The workspace volume root belongs to root (group theia via fsGroup), so git would refuse it
# as dubious ownership. The base image has no git, so this lives here in every edition.
RUN git config --system --add safe.directory /home/project
RUN --mount=type=bind,source=scripts/collect-template-json.js,target=/tmp/collect-template-json.js \
    node /tmp/collect-template-json.js /opt/eduide/template.json javascript
USER theia

EXPOSE 3000

# Specify default shell for Theia and the Built-In plugins directory
# Webviews and the HTML preview (mini-browser) share one fixed host, webview.{{hostname}}, which
# the gateway routes and certifies (control plane decision G3, no wildcard host). ENV is not
# inherited from the base image.
ENV SHELL=/bin/zsh \
    THEIA_DEFAULT_PLUGINS=local-dir:/home/theia/plugins \
    THEIA_WEBVIEW_EXTERNAL_ENDPOINT="webview.{{hostname}}" \
    THEIA_MINI_BROWSER_HOST_PATTERN="webview.{{hostname}}"

# Use installed git instead of dugite
ENV USE_LOCAL_GIT=true

# Let plain `node`/`tsc` resolve the globally-installed npm packages (typescript, tsx)
ENV NODE_PATH=/usr/local/lib/node_modules

WORKDIR /home/theia/applications/browser

# Stamp the published image coordinates into the environment so the About
# dialog can name the image this session is running. The revision is what
# separates two builds that share a tag, such as successive `latest` ones.
# CI supplies all three; a hand-built image leaves them empty and the dialog
# then says "unknown".
ARG APP_VERSION=""
ARG IMAGE_NAME=""
ARG IMAGE_REVISION=""
ENV EDUIDE_IMAGE_NAME=${IMAGE_NAME} \
    EDUIDE_IMAGE_TAG=${APP_VERSION} \
    EDUIDE_IMAGE_REVISION=${IMAGE_REVISION}

# Fail the build if a language patch dropped an extension EduIDE itself needs
RUN --mount=type=bind,source=scripts/check-required-plugins.sh,target=/tmp/check-required-plugins.sh \
    sh /tmp/check-required-plugins.sh /home/theia/plugins

# Launch the backend application via node
# The Artemis extension asks the session bridge for its login only when this is set; build.yml
# turns it on for the artemis edition.
ARG DATA_BRIDGE_ENABLED=false
ENV DATA_BRIDGE_ENABLED=${DATA_BRIDGE_ENABLED}

ENTRYPOINT [ "node", "/home/theia/applications/browser/lib/backend/main.js" ]

# Arguments passed to the application
CMD [ "/home/project", "--hostname=127.0.0.1" ]
