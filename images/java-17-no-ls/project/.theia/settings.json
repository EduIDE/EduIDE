{
    "_comment": "java.server.launchMode is NOT needed - redhat.java extension is not installed in this image. We use theia-lsp extension instead to connect to external JDT-LS via TCP.",
    "extensions.ignoreRecommendations": true,
    "files.exclude": {
        "**/.theia": true,
        "persisted": true,
        "lost+found": true
    },
    "telemetry.telemetryLevel": "off",
    "ai-features.AiEnable.enableAI": true,
    "ai-features.openAiCustom.customOpenAiModels": [
        {
            "model": "openai/gpt-oss-120b",
            "url": "https://gpu.ase.cit.tum.de/api",
            "id": "custom/gpt-oss-120b",
            "apiKey": true,
            "developerMessageSettings": "user"
        },
        {
            "model": "google/gemma-4-26B-A4B-it",
            "url": "https://gpu.ase.cit.tum.de/api",
            "id": "custom/gemma-4",
            "apiKey": true,
            "developerMessageSettings": "user"
        }
    ],
    "ai-features.openAiOfficial.officialOpenAiModels": [
        "gpt-4o",
        "gpt-4.1",
        "gpt-4.1-nano",
        "gpt-4.1-mini",
        "gpt-4o-2024-11-20",
        "gpt-4o-2024-08-06",
        "gpt-4o-mini",
        "o3",
        "o3-mini",
        "o4-mini",
        "o4-mini-high",
        "gpt-4.5-preview",
        "gpt-5",
        "gpt-5-mini",
        "gpt-5-nano"
    ],
    "ai-features.languageModelAliases": {},
    "toolbar.showToolbar": false,
    "terminal.integrated.enableCommandHistory": true,
    "terminal.integrated.enableCommandSeparator": true,
    "terminal.integrated.enableCommandBlockActions": true,
    "window.titleBarStyle": "native",
    "ai-features.agentSettings": {
        "Terminal Assistant": {
            "languageModelRequirements": [
                {
                    "purpose": "suggest-terminal-commands",
                    "identifier": "open-webui:openai/gpt-oss-120b"
                }
            ]
        },
        "Terminal Summary": {
            "languageModelRequirements": [
                {
                    "purpose": "summarize-terminal-output",
                    "identifier": "open-webui:openai/gpt-oss-120b"
                }
            ]
        }
    },
    "ai-features.ai-terminal-assistant.mode": "standalone",
    "ai-features.openWebUi.baseUrl": "https://gpu.ase.cit.tum.de",
    "ai-features.openWebUi.autoDiscoverModels": true,
    "ai-features.openWebUi.models": [
        "openai/gpt-oss-120b",
        "google/gemma-4-26B-A4B-it"
    ]
}
